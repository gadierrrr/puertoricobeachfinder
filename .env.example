DB_PATH=./data/beach-finder.db
APP_URL=http://localhost:8082
APP_NAME=Beach Finder
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_PROVIDER=resend
ANTHROPIC_API_KEY=
REFERRAL_ALLOWED_HOSTS=expedia.com,www.expedia.com
BACKUP_DIR=./backups/db
BACKUP_KEEP_DAYS=30
APP_ENV=dev
APP_DEBUG=1

# Umami analytics (optional)
UMAMI_ENABLED=0
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
UMAMI_WEBSITE_ID=
UMAMI_DOMAINS=puertoricobeachfinder.com,www.puertoricobeachfinder.com

# Google Analytics 4 (optional) — set to your GA4 Measurement ID (e.g. G-XXXXXXXXXX)
# to enable gtag.js. Leave blank to disable. Find it in GA Admin > Data Streams.
GA_MEASUREMENT_ID=

# Retention: unsubscribe HMAC secret + web push VAPID keypair (generate via scripts/generate-vapid.php)
APP_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
