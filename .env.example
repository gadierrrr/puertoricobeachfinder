DB_PATH=./data/beach-finder.db
APP_URL=http://localhost:8082
APP_NAME=Beach Finder
# Google Cloud key with Places API (New) enabled.
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_PROVIDER=resend
ANTHROPIC_API_KEY=
REFERRAL_ALLOWED_HOSTS=expedia.com,www.expedia.com,viator.com,www.viator.com
VIATOR_PID=
VIATOR_API_KEY=
VIATOR_API_BASE_URL=https://api.viator.com/partner
VIATOR_API_ENABLED=0
VIATOR_SYNC_TTL_HOURS=24
BACKUP_DIR=./backups/db
BACKUP_KEEP_DAYS=30
APP_ENV=dev
APP_DEBUG=1

# Public rendering mode. Use ?design=classic or ?design=redesign for a local one-request override.
HOMEPAGE_DESIGN=redesign

# Google Analytics 4 — set to your GA4 Measurement ID (e.g. G-XXXXXXXXXX)
# to enable gtag.js. Leave blank to disable. Find it in GA Admin > Data Streams.
# Required in production: the analytics health probe alerts when missing.
GA_MEASUREMENT_ID=

# Retention: unsubscribe HMAC secret + web push VAPID keypair (generate via scripts/generate-vapid.php)
APP_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
